      <aliases enabled='yes' />
      <column caption='Accepted Cmp Overall' datatype='integer' name='[AcceptedCmpOverall]' role='measure' type='quantitative' />
      <column caption='Total Customers' datatype='integer' name='[Calculation_0685592705249281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Recency])' />
      </column>
      <column caption='Campaign Responses' datatype='integer' name='[Calculation_0685592705835010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Response])' />
      </column>
      <column caption='Response Rate' datatype='real' name='[Calculation_0685592706510851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Response]) / COUNT([Recency])' />
      </column>
      <column caption='Total Spending' datatype='integer' name='[Calculation_0685592707440644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([MntTotal])' />
      </column>
      <column caption='Average Income' datatype='real' name='[Calculation_0685592708030469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Income])' />
      </column>
      <column caption='Total Purchases' datatype='integer' name='[Calculation_0685592708349958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([NumWebPurchases])&#13;&#10;+&#13;&#10;SUM([NumCatalogPurchases])&#13;&#10;+&#13;&#10;SUM([NumStorePurchases])' />
      </column>
      <column caption='Average Spending' datatype='real' name='[Calculation_0685592708734983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([MntTotal])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0685592709042184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 30 THEN &quot;Under 30&quot;&#13;&#10;ELSEIF [Age] &lt; 40 THEN &quot;30-39&quot;&#13;&#10;ELSEIF [Age] &lt; 50 THEN &quot;40-49&quot;&#13;&#10;ELSEIF [Age] &lt; 60 THEN &quot;50-59&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer Segment' datatype='string' name='[Calculation_0685592709521417]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MntTotal] &gt;= 1000 THEN &quot;High Spender&quot;&#13;&#10;ELSEIF [MntTotal] &gt;= 500 THEN &quot;Medium Spender&quot;&#13;&#10;ELSE &quot;Low Spender&quot;&#13;&#10;END' />
      </column>
      <column caption='Recency Group' datatype='string' name='[Calculation_0685592709730314]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Recency] &lt;= 30 THEN &quot;Recent&quot;&#13;&#10;ELSEIF [Recency] &lt;= 60 THEN &quot;Moderate&quot;&#13;&#10;ELSE &quot;Inactive&quot;&#13;&#10;END' />
      </column>
      <column caption='Preferred Channel' datatype='string' name='[Calculation_0685592709943307]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NumWebPurchases] &gt;= [NumStorePurchases]&#13;&#10;AND [NumWebPurchases] &gt;= [NumCatalogPurchases]&#13;&#10;THEN &quot;Web&quot;&#13;&#10;&#13;&#10;ELSEIF [NumStorePurchases] &gt;= [NumCatalogPurchases]&#13;&#10;THEN &quot;Store&quot;&#13;&#10;&#13;&#10;ELSE &quot;Catalog&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Children' datatype='integer' name='[Calculation_0685592710201356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Kidhome] + [Teenhome]' />
      </column>
      <column caption='Income Group' datatype='string' name='[Calculation_1091588572622848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Income] &lt; 35000 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Income] &lt; 70000 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Tenure Group' datatype='string' name='[Calculation_1091588574228482]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Customer_Days] &lt; 365 THEN &quot;New (&lt; 1 year)&quot;&#13;&#10;ELSEIF [Customer_Days] &lt; 730 THEN &quot;Established (1-2 years)&quot;&#13;&#10;ELSE &quot;Loyal (2+ years)&quot;&#13;&#10;END' />
      </column>
      <column caption=' Has Complained' datatype='string' name='[Calculation_1091588574945283]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Complain] = 1 THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
      </column>
      <column caption='Spending Tier' datatype='string' name='[Calculation_1091588576088068]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0685592707440644] &lt; 200 THEN &quot;Low Spender&quot;&#13;&#10;ELSEIF [Calculation_0685592707440644] &lt; 1000 THEN &quot;Medium Spender&quot;&#13;&#10;ELSE &quot;High Spender&quot;&#13;&#10;END' />
      </column>
      <column caption='Campaign Acceptance Rate' datatype='real' name='[Calculation_1091588576227333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([AcceptedCmp1]+[AcceptedCmp2]+[AcceptedCmp3]+[AcceptedCmp4]+[AcceptedCmp5]+[Response]) / 6' />
      </column>
      <column caption='Customer ID' datatype='integer' name='[Calculation_1091588578197510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
